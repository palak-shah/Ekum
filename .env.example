# Copy to apps/api/.env for local development.

# --- API ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed web origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://ekum:ekum@localhost:5432/ekum?schema=public"

# --- Auth (OTP + JWT) ---
# Use long, random values (>= 32 chars). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Return the OTP in the API response for local testing. NEVER true in production.
OTP_EXPOSE_DEV_CODE=true

# --- Web push (VAPID) ---
# Optional. Leave unset to disable push; the in-app notification feed still works.
# Generate a keypair with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@ekum.app

# --- Media storage (Azure Blob) ---
# Optional. Leave the account/key unset to use the local dev storage driver
# (stub upload URLs under PUBLIC_MEDIA_BASE_URL). Set both to enable direct-to-blob.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=media
PUBLIC_MEDIA_BASE_URL=http://localhost:3000/media
MEDIA_UPLOAD_TTL=10m

# --- Orders ---
# Days a buyer may raise a return after delivery (0 disables the window).
RETURN_WINDOW_DAYS=7

# --- Background jobs ---
# The Postgres-backed job runner (thumbnails, return-window expiry, digests).
# Never runs under NODE_ENV=test. Disable on instances that should not process jobs.
JOBS_ENABLED=true
JOBS_POLL_MS=15000

# --- Web (apps/web/.env, prefixed with VITE_) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Public site origin for Open Graph image URLs in index.html (no trailing slash).
# Production: https://your-ekum-host.example
VITE_PUBLIC_ORIGIN=http://localhost:5173
# Optional: enables the "Turn on push" toggle. Use the same public key as WEB_PUSH_PUBLIC_KEY.
VITE_WEB_PUSH_PUBLIC_KEY=
