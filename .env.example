# Copy to apps/api/.env for local development.

# --- API ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed web origins for CORS
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://ekum:ekum@localhost:5432/ekum?schema=public"

# --- Auth (OTP + JWT) ---
# Use long, random values (>= 32 chars). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Return the OTP in the API response for local testing. NEVER true in production.
OTP_EXPOSE_DEV_CODE=true

# --- Web (apps/web/.env, prefixed with VITE_) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
