# Copy to repo root as `.env.docker` for `pnpm docker:up`.
# Compose loads this for the API service (and build args for web via shell env / defaults).

# Runtime mode for local Compose demos (OTP expose allowed). Use production only with OTP_EXPOSE_DEV_CODE=false.
NODE_ENV=development

# --- Public URL (Nginx gateway) ---
EKUM_HTTP_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PUBLIC_MEDIA_BASE_URL=http://localhost:8080/media

# Baked into the web image at build time (same-origin via Nginx)
VITE_API_BASE_URL=/api/v1
VITE_PUBLIC_ORIGIN=http://localhost:8080
VITE_WEB_PUSH_PUBLIC_KEY=

# --- Auth (OTP + JWT) ---
# Use long, random values (>= 32 chars). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-docker-access-secret-change-me-0123456789ab
JWT_REFRESH_SECRET=dev-docker-refresh-secret-change-me-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=10y
# Return the OTP in the API response for local Docker demos. NEVER true in real production.
OTP_EXPOSE_DEV_CODE=true

# --- Web push (optional) ---
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@ekum.app

# --- Media (local disk in volume ekum_media; leave Azure unset) ---
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=media
MEDIA_UPLOAD_TTL=10m

# --- Orders ---
RETURN_WINDOW_DAYS=7

# --- Background jobs ---
JOBS_ENABLED=true
JOBS_POLL_MS=15000
