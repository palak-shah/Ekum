// Ekum database schema.
//
// Shared-schema multi-tenancy: Ekum is a cross-tenant marketplace, so every
// business table carries an owning companyId (or two, for relationship
// entities) and authorization is enforced in the application layer via the
// Access & Trust domain, never through database-level tenant isolation.
//
// Enum-like columns are stored as String and validated against the shared
// @ekum/domain-types enums at the application boundary, so those enums stay the
// single source of truth and value changes do not require a DB migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Identity & Access ------------------------------------------------------

/// A person, authenticated by phone/OTP. Never a buyer/supplier "type".
model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   CompanyMembership[]
  refreshTokens RefreshToken[]

  notificationPreference NotificationPreference?
  pushSubscriptions      PushSubscription[]
  mediaUploaded          Media[]

  productsCreated    Product[]    @relation("ProductCreatedBy")
  productsUpdated    Product[]    @relation("ProductUpdatedBy")
  collectionsCreated Collection[] @relation("CollectionCreatedBy")
  collectionsUpdated Collection[] @relation("CollectionUpdatedBy")
  ordersCreated      Order[]         @relation("OrderCreatedByUser")
  ordersUpdated      Order[]         @relation("OrderUpdatedByUser")
  ordersQuoted       Order[]         @relation("OrderQuotedByUser")
  ordersConfirmed    Order[]         @relation("OrderConfirmedByUser")
  ordersDelivered    Order[]         @relation("OrderDeliveredByUser")
  shipmentsDispatched OrderShipment[] @relation("ShipmentDispatchedByUser")
  savedItems         SavedItem[]
}

/// The tenant root. A company may buy, sell, or both — capabilities are data.
model Company {
  id           String  @id @default(cuid())
  name         String
  city         String
  about        String?
  logoUrl      String?
  gstNumber    String?
  verification String  @default("not_verified") // VerificationStatus

  // Capabilities unlock progressively as the business actually uses them.
  canPublish Boolean @default(false)
  canRelist  Boolean @default(false)
  canRefer   Boolean @default(true)

  sellCategories   String[] @default([])
  buyCategories    String[] @default([])
  // Coarse onboarding chips (SuperCategory). Fine product tags stay in sellCategories.
  superCategories  String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships CompanyMembership[]

  accessRequestsSent     AccessRequest[] @relation("AccessRequester")
  accessRequestsReceived AccessRequest[] @relation("AccessTarget")
  connectionsAsOwner     Connection[]    @relation("ConnectionOwner")
  connectionsAsViewer    Connection[]    @relation("ConnectionViewer")

  products     Product[]
  collections  Collection[]
  addresses    Address[]
  billingFirms BillingFirm[]
  settings     CompanySettings?

  following Follow[] @relation("Follower")
  followers Follow[] @relation("Followed")

  threadsCreated       Thread[]            @relation("ThreadCreator")
  threadParticipations ThreadParticipant[] @relation("ThreadMembership")
  messagesSent         Message[]           @relation("MessageSender")

  ordersAsBuyer   Order[]  @relation("OrderBuyer")
  ordersAsSeller  Order[]  @relation("OrderSeller")
  ordersFacilitated Order[] @relation("OrderFacilitator")
  samplesAsBuyer  Sample[] @relation("SampleBuyer")
  samplesAsSeller Sample[] @relation("SampleSeller")

  broadcastLists  BroadcastList[]
  broadcastsSent  Broadcast[]
  referralsMade   Referral[]      @relation("ReferralReferrer")
  referralsFor    Referral[]      @relation("ReferralTarget")
  notifications   Notification[]
  media           Media[]
  savedItems      SavedItem[]
  teamInvites     TeamInvite[]
}

/// The join between a User and a Company. Modelled many-to-many from day one so
/// multi-user companies (and one person across businesses) never need a retrofit.
model CompanyMembership {
  id        String @id @default(cuid())
  userId    String
  companyId String
  role      String @default("owner") // MembershipRole: owner | staff

  // Owner-set permission hard caps.
  canUploads  Boolean @default(true)
  canChats    Boolean @default(true)
  canOrders   Boolean @default(true)
  canPayments Boolean @default(true)
  canTeam     Boolean @default(true)

  // Public-safe contact point tag (e.g. Sales, Accounts, Dispatch). Phone stays
  // hidden unless the business explicitly opts in; the login phone is never shown.
  contactRole  String?
  showPhone    Boolean @default(false)
  displayPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

/// Owner-issued invite for a person to join as staff (phone-bound).
model TeamInvite {
  id              String    @id @default(cuid())
  companyId       String
  invitedByUserId String
  token           String    @unique
  name            String
  phone           String
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([phone])
}

/// A hashed refresh token (rotation). The raw token is only ever held by the client.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A short-lived OTP challenge. Codes are stored hashed, never in plaintext.
model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
}

// --- Access & Trust ---------------------------------------------------------

/// The named Access gate. A requester (would-be viewer) asks a target (owner)
/// to see controlled collections; approval creates a Connection.
model AccessRequest {
  id                 String    @id @default(cuid())
  requesterCompanyId String
  targetCompanyId    String
  note               String?
  referredBy         String?
  status             String    @default("pending") // AccessRequestStatus
  createdAt          DateTime  @default(now())
  decidedAt          DateTime?

  requester Company @relation("AccessRequester", fields: [requesterCompanyId], references: [id], onDelete: Cascade)
  target    Company @relation("AccessTarget", fields: [targetCompanyId], references: [id], onDelete: Cascade)

  @@index([targetCompanyId, status])
  @@index([requesterCompanyId])
}

/// A directional, approved access grant: the viewer company may see the owner
/// company's controlled catalogue. Pausing and blocking are deliberately silent.
model Connection {
  id              String   @id @default(cuid())
  ownerCompanyId  String
  viewerCompanyId String
  status          String   @default("active") // ConnectionStatus: active | paused | blocked
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner  Company @relation("ConnectionOwner", fields: [ownerCompanyId], references: [id], onDelete: Cascade)
  viewer Company @relation("ConnectionViewer", fields: [viewerCompanyId], references: [id], onDelete: Cascade)

  @@unique([ownerCompanyId, viewerCompanyId])
  @@index([viewerCompanyId, status])
  @@index([ownerCompanyId, status])
}

// --- Catalog ----------------------------------------------------------------

/// The live product (design) entity. Name required; SKU assigned on create
/// (user or system) and then immutable; rate nullable ("on request").
/// Orders snapshot a product at order time rather than linking live.
model Product {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  sku         String?
  description String?
  /** Minimum order quantity in pieces; null = not specified. */
  moq         Int?
  rate        Decimal? @db.Decimal(12, 2)
  unit        String?
  categories  String[] @default([])
  images      String[] @default([])
  status      String   @default("draft") // ProductStatus
  // Market post fields (Explore). Publish sets audience + postedToMarketAt together.
  audience            String    @default("connections")
  rateVisibility      String    @default("on_request")
  audienceCompanyIds  String[]  @default([])
  /** Buyer groups chosen when audience = selected (for Visibility restore). */
  audienceGroupIds    String[]  @default([])
  /** When false, only the owner may share this design into chat; buyers cannot forward. */
  allowForward        Boolean   @default(true)
  postedToMarketAt    DateTime?
  createdByUserId     String?
  updatedByUserId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUser   User?               @relation("ProductCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?               @relation("ProductUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  collections     CollectionProduct[]
  savedItems      SavedItem[]

  @@index([companyId, status])
  @@index([postedToMarketAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

/// A curated set of products. Separate from Product and joined many-to-many, so
/// a product can live in several collections without duplication.
model Collection {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  description    String?
  coverImage     String?
  status         String   @default("draft") // CollectionStatus
  // Decided at publish time (PublishAudience / RateVisibility).
  audience            String   @default("connections")
  rateVisibility      String   @default("on_request")
  /** When audience = selected, only these company IDs may discover/view the collection. */
  audienceCompanyIds  String[] @default([])
  /** Buyer groups chosen when audience = selected (for Visibility restore). */
  audienceGroupIds    String[] @default([])
  /** When false, only the owner may share this pack into chat; buyers cannot forward. */
  allowForward        Boolean  @default(true)
  /** direct | handle; null = use company Profile orderPathPreference. */
  orderPathPreference String?
  /**
   * Explore sort key. Set on publish and when newly added published designs join
   * a live collection — not on rename/remove-only/reshuffle.
   */
  exploreActivityAt   DateTime?
  /** Live window start (UTC). null = live as soon as published. */
  startsAt            DateTime?
  /** Live window end (UTC). null = evergreen. When passed → Hide to draft. */
  endsAt              DateTime?
  createdByUserId     String?
  updatedByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUser User?               @relation("CollectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser User?               @relation("CollectionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  products      CollectionProduct[]
  savedItems    SavedItem[]

  @@index([companyId, status])
  @@index([exploreActivityAt])
  @@index([status, endsAt])
  @@index([status, startsAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

/// The ordered many-to-many join between Collection and Product.
model CollectionProduct {
  id           String   @id @default(cuid())
  collectionId String
  productId    String
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([productId])
}

/// A reference bookmark: exactly one of productId or collectionId (enforced in
/// the service layer). Postgres allows multiple NULLs in unique constraints.
model SavedItem {
  id           String   @id @default(cuid())
  companyId    String
  productId    String?
  collectionId String?
  savedByUserId String?
  createdAt    DateTime @default(now())

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  savedByUser User?      @relation(fields: [savedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@unique([companyId, productId])
  @@unique([companyId, collectionId])
}

// --- Discovery --------------------------------------------------------------

/// A permissionless follow: any company may follow any other to keep up with its
/// published content. Distinct from Access, which gates private catalogue viewing.
model Follow {
  id                String   @id @default(cuid())
  followerCompanyId String
  followedCompanyId String
  createdAt         DateTime @default(now())

  follower Company @relation("Follower", fields: [followerCompanyId], references: [id], onDelete: Cascade)
  followed Company @relation("Followed", fields: [followedCompanyId], references: [id], onDelete: Cascade)

  @@unique([followerCompanyId, followedCompanyId])
  @@index([followedCompanyId])
}

// --- Conversation -----------------------------------------------------------

/// A conversation between companies. Direct threads are the canonical 1:1
/// channel (find-or-created); group threads (trader + supplier + buyer) carry a
/// title. `visibility` scopes an owner_only thread away from staff members.
model Thread {
  id                 String   @id @default(cuid())
  type               String   @default("direct") // ThreadType: direct | group
  visibility         String   @default("shared") // ThreadVisibility: shared | owner_only
  title              String?
  createdByCompanyId String
  lastMessageAt      DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdBy    Company             @relation("ThreadCreator", fields: [createdByCompanyId], references: [id], onDelete: Cascade)
  participants ThreadParticipant[]
  messages     Message[]

  @@index([type])
}

/// A company's membership of a thread, holding its private per-thread state:
/// requests-inbox status, mute level, pin, and read watermark.
model ThreadParticipant {
  id         String    @id @default(cuid())
  threadId   String
  companyId  String
  state      String    @default("active") // ThreadParticipantState: active | pending | archived
  alertLevel String    @default("all") // ThreadAlertLevel: all | muted
  /** When set, this chat is pinned for the company (private; sorted above unpinned). */
  pinnedAt   DateTime?
  lastReadAt DateTime?
  invitedBy  String?
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?

  thread  Thread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  company Company @relation("ThreadMembership", fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([threadId, companyId])
  @@index([companyId, state])
  @@index([companyId, pinnedAt])
}

/// A single message. Cards reference a trade object by id (never a copy), so the
/// rendered card always resolves to the live, permission-checked object.
model Message {
  id               String  @id @default(cuid())
  threadId         String
  senderCompanyId  String
  /** Staff member who sent (null for legacy / system-generated). */
  senderUserId     String?
  /** Snapshot of sender display name at send time (team-visible only). */
  senderName       String?
  type             String  @default("text") // MessageType
  body             String?
  referenceId      String? // product / collection / order id for *_card types
  metadata         Json?
  /** Same-thread message this is a reply to (optional). */
  replyToMessageId String?
  createdAt        DateTime @default(now())

  thread  Thread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender  Company @relation("MessageSender", fields: [senderCompanyId], references: [id], onDelete: Cascade)
  replyTo Message?  @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies Message[] @relation("MessageReplies")

  @@index([threadId, createdAt])
  @@index([threadId, type, createdAt])
  @@index([replyToMessageId])
}

// --- Orders & Fulfillment ---------------------------------------------------

/// One order object shared by a buyer and a seller company, read from either
/// perspective. Dispatch fields are fulfillment metadata only; they never gate
/// the requested -> confirmed -> dispatched -> delivered state machine.
model Order {
  id                 String    @id @default(cuid())
  kind               String    @default("standard") // OrderKind: standard | photo
  /// Commitment: order (firm) | inquiry (rate ask). Flips to order on quote/confirm/accept.
  intent             String    @default("order") // OrderIntent
  status             String    @default("requested") // OrderStatus
  /// Buyer amends before seller quote/confirm/decline.
  amendCount         Int       @default(0)
  buyerCompanyId     String
  sellerCompanyId    String
  createdByCompanyId String
  /// bilateral | manage | direct — Slice B dual trade
  tradeMode            String  @default("bilateral")
  /// Direct mode: company kept informed / may Take control
  facilitatorCompanyId String?
  /// Upstream Manage hop points at buyer-facing manage order
  downstreamOrderId    String?
  /// Null + downstreamOrderId set = held from the mill until Send.
  upstreamReleasedAt   DateTime?
  note               String?
  transporter        String?
  lrNumber           String?
  parcelCount        Int?
  confirmedAt          DateTime?
  /** Company that moved the order to confirmed (seller confirm or buyer accept-quote). */
  confirmedByCompanyId String?
  confirmedByUserId    String?
  quotedAt             DateTime?
  quotedByUserId       String?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  deliveredByUserId    String?
  // The buyer may raise returns until this instant; a background job closes the
  // window when it passes. Null until the order is delivered.
  returnWindowClosesAt DateTime?
  closedAt           DateTime?
  createdByUserId    String?
  updatedByUserId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  buyer         Company     @relation("OrderBuyer", fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  seller        Company     @relation("OrderSeller", fields: [sellerCompanyId], references: [id], onDelete: Cascade)
  facilitator   Company?    @relation("OrderFacilitator", fields: [facilitatorCompanyId], references: [id], onDelete: SetNull)
  downstream    Order?      @relation("OrderUpstreamLink", fields: [downstreamOrderId], references: [id], onDelete: SetNull)
  upstreams     Order[]     @relation("OrderUpstreamLink")
  createdByUser   User?       @relation("OrderCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?       @relation("OrderUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  quotedByUser    User?       @relation("OrderQuotedByUser", fields: [quotedByUserId], references: [id], onDelete: SetNull)
  confirmedByUser User?       @relation("OrderConfirmedByUser", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  deliveredByUser User?       @relation("OrderDeliveredByUser", fields: [deliveredByUserId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  shipments     OrderShipment[]
  returns          Return[]
  complaints       Complaint[]
  paymentRequests  PaymentRequest[]
  acceptInvites    OrderAcceptInvite[]

  @@index([buyerCompanyId, status])
  @@index([sellerCompanyId, status])
  @@index([facilitatorCompanyId])
  @@index([downstreamOrderId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([confirmedByUserId])
  @@index([quotedByUserId])
  @@index([deliveredByUserId])
}

/// Line snapshot. requestedQuantity is the buyer ask; quantity is the current
/// agreed/offered amount (seller quote may lower it). lineStatus tracks partial
/// outcomes; order.status is a rollup.
model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String?
  name              String
  sku               String?
  rate              Decimal? @db.Decimal(12, 2)
  unit              String?
  image             String?
  images            String[] @default([])
  quantity          Decimal  @db.Decimal(12, 2)
  requestedQuantity Decimal  @db.Decimal(12, 2)
  /// OrderLineStatus: open | declined | confirmed | dispatched | delivered
  lineStatus        String   @default("open")
  note              String?
  createdAt         DateTime @default(now())

  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipmentItems  OrderShipmentItem[]

  @@index([orderId])
}

/// One physical dispatch (LR) against an order — supports split fulfillment.
model OrderShipment {
  id           String    @id @default(cuid())
  orderId      String
  transporter  String?
  lrNumber     String?
  parcelCount  Int?
  dispatchedAt DateTime  @default(now())
  dispatchedByUserId String?
  createdAt    DateTime  @default(now())

  order            Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dispatchedByUser User? @relation("ShipmentDispatchedByUser", fields: [dispatchedByUserId], references: [id], onDelete: SetNull)
  items            OrderShipmentItem[]

  @@index([orderId])
}

model OrderShipmentItem {
  id          String  @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Decimal @db.Decimal(12, 2)

  shipment  OrderShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([orderItemId])
}

/// A sample request. Shares the party model and dispatch vocabulary of an order
/// but a simpler requested -> dispatched -> received/declined -> converted flow.
model Sample {
  id              String    @id @default(cuid())
  buyerCompanyId  String
  sellerCompanyId String
  productId       String?
  name            String
  note            String?
  status          String    @default("requested") // SampleStatus
  transporter     String?
  lrNumber        String?
  dispatchedAt    DateTime?
  receivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  buyer  Company @relation("SampleBuyer", fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  seller Company @relation("SampleSeller", fields: [sellerCompanyId], references: [id], onDelete: Cascade)

  @@index([buyerCompanyId, status])
  @@index([sellerCompanyId, status])
}

/// A return raised by an order's buyer. The seller may approve in full or in
/// part; a trader can escalate it upstream against their own purchase order.
model Return {
  id                    String    @id @default(cuid())
  orderId               String
  buyerCompanyId        String
  sellerCompanyId       String
  reason                String?
  status                String    @default("requested") // ReturnStatus
  escalatedFromReturnId String?
  decidedAt             DateTime?
  resolvedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items         ReturnItem[]
  escalatedFrom Return?      @relation("ReturnEscalation", fields: [escalatedFromReturnId], references: [id])
  escalations   Return[]     @relation("ReturnEscalation")

  @@index([orderId])
  @@index([buyerCompanyId, status])
  @@index([sellerCompanyId, status])
}

model ReturnItem {
  id                String   @id @default(cuid())
  returnId          String
  orderItemId       String
  name              String
  requestedQuantity Decimal  @db.Decimal(12, 2)
  approvedQuantity  Decimal? @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

/// A complaint against the counterpart on an order.
model Complaint {
  id                String    @id @default(cuid())
  orderId           String
  raisedByCompanyId String
  againstCompanyId  String
  subject           String
  detail            String?
  status            String    @default("open") // ComplaintStatus
  response          String?
  respondedAt       DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([raisedByCompanyId])
  @@index([againstCompanyId])
}

/// Honour-system pay ask on an order. Ekum does not move money.
model PaymentRequest {
  id           String    @id @default(cuid())
  orderId      String
  amount       Decimal
  note         String?
  instructions String?
  status       String    @default("open") // PaymentRequestStatus
  seenAt       DateTime?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

/// Off-app 48h door to one album or design. After login, normal audience rules.
model CatalogShareLink {
  id                 String   @id @default(cuid())
  token              String   @unique
  collectionId       String?
  productId          String?
  createdByCompanyId String
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  @@index([expiresAt])
}

/// Off-app Accept link for a seller-logged order. One use; ~7 days.
model OrderAcceptInvite {
  id        String    @id @default(cuid())
  orderId   String
  token     String    @unique
  phone     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([phone, usedAt])
}

// --- Settings (reference data) ----------------------------------------------

/// A dispatch/office address belonging to a company.
model Address {
  id        String   @id @default(cuid())
  companyId String
  label     String
  line1     String
  line2     String?
  city      String
  state     String?
  pincode   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// A GST/billing firm a company bills under (a company may have several).
model BillingFirm {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  gstNumber   String?
  addressLine String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// One-per-company settings blob: return policy and free-form trade defaults /
/// "My Tools" toggles. Kept as JSON so the shape can evolve without migrations.
model CompanySettings {
  id            String   @id @default(cuid())
  companyId     String   @unique
  returnPolicy  String?
  tradeDefaults Json?
  myTools       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// --- Broadcast --------------------------------------------------------------

/// Buyer group: saved recipients for publish audience, share, and broadcast.
model BroadcastList {
  id                    String   @id @default(cuid())
  companyId             String
  name                  String
  memberCompanyIds      String[] @default([])
  /** Null = inherit company usual; else RateVisibility override for this group. */
  defaultRateVisibility String?
  /** Null = inherit company usual; else forward override for this group. */
  allowForward          Boolean?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// One composed message sent immediately to many recipients. Each delivery is a
/// BroadcastRecipient row; there is no shared visibility between recipients.
model Broadcast {
  id              String   @id @default(cuid())
  senderCompanyId String
  type            String   @default("text") // MessageType
  subject         String
  body            String?
  referenceId     String?
  status          String   @default("sent") // BroadcastStatus
  createdAt       DateTime @default(now())

  sender     Company              @relation(fields: [senderCompanyId], references: [id], onDelete: Cascade)
  recipients BroadcastRecipient[]

  @@index([senderCompanyId])
}

model BroadcastRecipient {
  id                 String   @id @default(cuid())
  broadcastId        String
  recipientCompanyId String
  createdAt          DateTime @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, recipientCompanyId])
  @@index([recipientCompanyId])
}

// --- Referral ---------------------------------------------------------------

/// A shareable vouch/invite token. Opening it lets the recipient send an access
/// request pre-attributed to the referrer (referredBy on AccessRequest).
model Referral {
  id                String   @id @default(cuid())
  referrerCompanyId String
  targetCompanyId   String?
  token             String   @unique
  note              String?
  createdAt         DateTime @default(now())

  referrer Company  @relation("ReferralReferrer", fields: [referrerCompanyId], references: [id], onDelete: Cascade)
  target   Company? @relation("ReferralTarget", fields: [targetCompanyId], references: [id], onDelete: Cascade)

  @@index([referrerCompanyId])
}

// --- Notifications ----------------------------------------------------------

/// A company-scoped feed entry, projected from a domain event. Read state is at
/// the company level in Phase 1; delivery preferences and push are per-user.
model Notification {
  id                 String   @id @default(cuid())
  recipientCompanyId String
  type               String // NotificationType
  title              String
  body               String?
  refType            String?
  refId              String?
  readAt             DateTime?
  createdAt          DateTime @default(now())

  recipient Company @relation(fields: [recipientCompanyId], references: [id], onDelete: Cascade)

  @@index([recipientCompanyId, readAt])
  @@index([recipientCompanyId, createdAt])
}

/// Per-user delivery preferences. A missing row means all defaults (push on).
model NotificationPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  pushEnabled Boolean  @default(true)
  mutedTypes  String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A web-push subscription for one browser/device belonging to a user.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Audit ------------------------------------------------------------------

/// Append-only record of trust-critical transitions (access approvals,
/// connection blocks, permission changes). Cheap now, impossible to reconstruct
/// later if a trust dispute arises.
model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?
  actorCompanyId String?
  action         String
  targetType     String
  targetId       String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorCompanyId])
}

// --- Media & Jobs -----------------------------------------------------------

/// A media object uploaded direct-to-blob. The API mints an upload ticket and
/// stores this row as `pending`; the client confirms upload (`uploaded`); a
/// background worker derives a thumbnail and marks it `ready`.
model Media {
  id           String   @id @default(cuid())
  companyId    String
  uploaderId   String?
  kind         String   @default("image") // MediaKind
  status       String   @default("pending") // MediaStatus
  contentType  String
  blobPath     String
  url          String
  thumbnailUrl String?
  sizeBytes    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploader User?   @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

/// A durable background job. Postgres is the queue: the runner claims due rows
/// with FOR UPDATE SKIP LOCKED, so multiple instances process without collision.
/// Used for thumbnail derivation, return-window expiry, and notification digests.
model Job {
  id          String    @id @default(cuid())
  type        String // JobType
  payload     Json?
  status      String    @default("pending") // JobStatus
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  lockedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}
