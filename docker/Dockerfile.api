# syntax=docker/dockerfile:1

FROM node:22-bookworm AS build
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.18.0 --activate

# Workspace manifests first (lockfile expects every workspace package)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/domain-types/package.json ./packages/domain-types/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/e2e/package.json ./apps/e2e/

RUN pnpm install --frozen-lockfile

COPY packages/config ./packages/config
COPY packages/domain-types ./packages/domain-types
COPY apps/api ./apps/api

RUN pnpm --filter @ekum/domain-types build \
  && pnpm --filter @ekum/api prisma:generate \
  && pnpm --filter @ekum/api build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@11.18.0 --activate

ENV NODE_ENV=production
ENV PORT=3000

COPY --from=build /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/api ./apps/api
COPY --from=build /app/apps/web/package.json ./apps/web/package.json
COPY --from=build /app/apps/e2e/package.json ./apps/e2e/package.json

COPY docker/api-entrypoint.sh /usr/local/bin/ekum-api-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/ekum-api-entrypoint.sh \
  && chmod +x /usr/local/bin/ekum-api-entrypoint.sh \
  && mkdir -p /app/apps/api/.media

WORKDIR /app/apps/api
EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/ekum-api-entrypoint.sh"]
