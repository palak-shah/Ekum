{
  "name": "ekum",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test scripts/release-gate.spec.mjs && pnpm -r test",
    "test:e2e:smoke": "pnpm --filter @ekum/e2e test:smoke",
    "test:e2e:smoke:preview": "pnpm --filter @ekum/e2e test:smoke:preview",
    "test:e2e:smoke:docker": "pnpm --filter @ekum/e2e test:smoke:docker",
    "test:e2e:functional": "pnpm --filter @ekum/e2e test:functional",
    "test:e2e:release": "pnpm --filter @ekum/e2e test:release",
    "release:check": "node scripts/release-gate.mjs check",
    "release:signoff": "node scripts/release-gate.mjs signoff",
    "release:exception": "node scripts/release-gate.mjs exception",
    "release:assert": "node scripts/release-gate.mjs assert",
    "release:post": "node scripts/release-gate.mjs post",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "docker:meta": "node scripts/resolve-build-meta.mjs",
    "docker:build": "node scripts/docker-build.mjs",
    "docker:up": "node scripts/docker-up.mjs",
    "docker:prune": "docker system prune -f",
    "docker:down": "node scripts/resolve-build-meta.mjs && docker compose --env-file .env.build down",
    "docker:down:volumes": "node scripts/resolve-build-meta.mjs && docker compose --env-file .env.build down -v",
    "docker:logs": "node scripts/resolve-build-meta.mjs && docker compose --env-file .env.build logs -f --tail=200",
    "docker:ps": "node scripts/resolve-build-meta.mjs && docker compose --env-file .env.build ps",
    "docker:seed": "node scripts/resolve-build-meta.mjs && docker compose --env-file .env.build exec -w /app api pnpm --filter @ekum/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
